{
  "url": "https://chat.deepseek.com/",
  "chromePath": "",
  "debugPort": 9333,
  "profileDir": "",
  "selectors": {
    "input": "textarea",
    "send": "",
    "message": ".ds-message",
    "reply": ".ds-markdown"
  },
  "page": {
    "limit": "too frequent|try again later|rate limit|请稍后|过于频繁",
    "continue": "^\\s*(continue( generating)?|继续生成)\\s*$"
  },
  "pollMs": 1000,
  "idleSec": 120,
  "retryWaitSec": 45,
  "maxResends": 5,
  "maxActionsPerBlock": 8,
  "maxResultChars": 150000,
  "maxMessageChars": 80000,
  "run": {
    "timeoutSec": 120,
    "maxTimeoutSec": 600,
    "block": [
      "\\b(format|shutdown|reboot|mkfs|diskpart)\\b",
      "\\breg(\\.exe)?\\s+(add|delete|import)\\b",
      "\\bgit\\s+push\\b",
      "(\\brm\\s+-\\w*r|\\b(rmdir|rd)\\s+/s|\\bdel\\s+/s|remove-item\\b.*-recurse).*(\\s|\"|')([a-z]:[\\\\/]|[\\\\/]|~|\\.\\.|%\\w+%|\\$)",
      "\\b(curl|wget|iwr|irm)\\b.*\\|\\s*(sh|bash|iex|powershell|pwsh)\\b",
      "\\.env\\b"
    ]
  },
  "claude": {
    "cmd": "claude",
    "args": [
      "--model",
      "haiku",
      "--permission-mode",
      "auto",
      "--tools",
      "Bash,Edit,Read,Write,Glob,Grep",
      "--strict-mcp-config",
      "--disable-slash-commands",
      "--setting-sources",
      "project",
      "--no-session-persistence"
    ],
    "timeoutSec": 900,
    "keepOpenSec": 30
  },
  "deny": []
}
